# AIHotPoint Server 配置
# 阿里云百炼（DashScope）
# 申请：https://dashscope.console.aliyun.com/apiKey （需开通百炼，模型 qwen3.7-max 按量计费）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-max

# Twitter (twitterapi.io)
# 申请：https://twitterapi.io 控制台 → 充值额度 → 生成 API Key
TWITTER_API_KEY=your_twitterapi_io_key
TWITTER_API_BASE=https://api.twitterapi.io

# 调度
CRAWL_CRON=*/5 * * * *     # 每 5 分钟抓一次全源
ENABLE_AI_ANALYZE=true
SNAPSHOT_CRON=0 * * * *    # 每小时做一次热度采样（故事趋势图数据源）
DAILY_CRON=0 8 * * *       # 每日 8 点生成前一天的 AI 日报（周报/月报同理定时生成）

# 全文抓取 + 中文翻译（仅对 high+ 或用户点开的条目，token 成本较高，默认关闭）
FULLTEXT_TRANSLATE=off     # on / off

# 服务
PORT=4000
DB_PATH=./data/aihotpoint.db
SITE_URL=https://aihotpoint.dev   # RSS 输出中的站点地址

# 抓取频率（毫秒），避免被封
CRAWL_DELAY_MIN=2000
CRAWL_DELAY_MAX=6000
